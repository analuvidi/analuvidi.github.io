---
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { getContent } from "@/lib/getContent";

const paragraphs = [
  "Estudo Análise e Desenvolvimento de Sistemas na UniViçosa. Antes do código, vieram os anos de atendimento, onde aprendi a entender o que cada pessoa precisa.",
  "Na monitoria, ensinei Figma a estudantes. Na Proton, conversei com clientes e participei da prototipação de projetos.",
  "Hoje, gosto de explorar o que agentes de IA podem fazer pelo trabalho. O que me atrai é esse encontro entre criatividade e tecnologia.",
];
---

<section class="scroll-mt-32" id="sobre">
  <Wrapper variant="standard" class="py-12 lg:py-14">
    <div class="grid grid-cols-1 lg:grid-cols-4 lg:gap-x-4 items-start">
      <div class="mb-2 lg:col-start-2 lg:mb-0">
        <Text
          tag="p"
          variant="textBase"
          class="text-base-600 dark:text-base-300"
          data-editable="sections.about.eyebrow"
        >
          {getContent("sections.about.eyebrow", "Sobre mim")}
        </Text>
      </div>
      <Text
        tag="h2"
        variant="displayMD"
        class="font-semibold leading-snug text-left tracking-tighter lg:col-span-2 text-base-900 dark:text-white"
        data-editable="sections.about.title"
      >
        {getContent("sections.about.title", "Aprendi a ouvir pessoas antes de aprender a desenhar telas.")}
      </Text>
    </div>

    <article class="mt-8 py-12 border-t border-base-200 dark:border-base-800">
      <div class="grid grid-cols-1 gap-4 lg:grid-cols-4 items-start">
        <div class="flex flex-col gap-4 lg:col-span-2 lg:col-start-3">
          {
            paragraphs.map((paragraph, index) => (
              <Text
                tag="p"
                variant="textBase"
                class="max-w-[58ch] text-base-600 dark:text-base-300"
                data-editable={`about.${index}`}
              >
                {getContent(`about.${index}`, paragraph)}
              </Text>
            ))
          }
        </div>
      </div>
    </article>
  </Wrapper>
</section>
