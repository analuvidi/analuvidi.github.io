---
import CaseCard from "@/components/landing/CaseCard.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { compactWorkItems, workItems } from "@/data/portfolio";
import { getContent } from "@/lib/getContent";

const workEyebrowDefault = "Da mais recente à mais antiga";
---

<section class="scroll-mt-32" id="work">
  <Wrapper variant="standard" class="py-12 lg:py-24">
    <div class="grid grid-cols-1 lg:grid-cols-4 items-start">
      <div class="lg:col-start-2">
        <Text
          tag="p"
          variant="textBase"
          class="text-base-600 dark:text-base-300"
          data-editable="sections.work.eyebrow"
          >{getContent("sections.work.eyebrow", workEyebrowDefault)}</Text
        >
      </div>
      <Text
        tag="h2"
        variant="textXL"
        class="font-semibold leading-snug text-left tracking-tighter lg:col-span-2 text-base-900 dark:text-white"
        data-editable="sections.work.title"
      >
        {getContent("sections.work.title", "Experiência")}
      </Text>
    </div>

    <div class="flex flex-col mt-8">
      {
        workItems.map((item) => (
          <CaseCard
            item={item}
            contentPrefix="work"
            basePath="trabalho"
          />
        ))
      }

      <article class="py-12 border-t border-base-200 dark:border-base-800">
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-4 items-start">
          <Text
            tag="p"
            variant="textSM"
            class="text-base-600 dark:text-base-300 uppercase"
            data-editable="sections.work.compactTitle"
          >
            {getContent("sections.work.compactTitle", "Experiências complementares")}
          </Text>
          <Text
            tag="p"
            variant="textBase"
            class="text-base-600 dark:text-base-300"
            data-editable="sections.work.compactText"
          >
            {
              getContent(
                "sections.work.compactText",
                "Trabalhos em atendimento e eventos que reforçam responsabilidade, adaptabilidade e trabalho em equipe.",
              )
            }
          </Text>
          <ul class="flex flex-col gap-4 lg:col-span-2">
            {
              compactWorkItems.map((item, index) => (
                <li class="grid grid-cols-1 gap-1 sm:grid-cols-2 sm:gap-4">
                  <div class="text-base text-base-900 dark:text-white">
                    <span data-editable={`work.compact.${index}.title`}>
                      {getContent(`work.compact.${index}.title`, item.title)}
                    </span>
                    <span class="block text-sm uppercase text-base-600 dark:text-base-300">
                      <span data-editable={`work.compact.${index}.year`}>
                        {getContent(`work.compact.${index}.year`, item.year)}
                      </span>
                    </span>
                  </div>
                  <div class="text-base text-base-600 dark:text-base-300">
                    <span data-editable={`work.compact.${index}.organization`}>{getContent(`work.compact.${index}.organization`, item.organization)}</span>.
                    <span data-editable={`work.compact.${index}.description`}>
                      {getContent(`work.compact.${index}.description`, item.description)}
                    </span>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </article>
    </div>
  </Wrapper>
</section>
