---
import CaseCard from "@/components/landing/CaseCard.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { projectItems } from "@/data/portfolio";
import { getContent } from "@/lib/getContent";

const projectsEyebrowDefault = "Trabalhos autorais";
const [featuredProject, ...otherProjects] = projectItems;
---

<section class="scroll-mt-32" id="projects">
  <Wrapper variant="standard" class="py-12 lg:py-14">
    <div class="grid grid-cols-1 lg:grid-cols-4 lg:gap-x-4 items-start">
      <div class="mb-2 lg:col-start-2 lg:mb-0">
        <Text
          tag="p"
          variant="textBase"
          class="text-base-600 dark:text-base-300"
          data-editable="sections.projects.eyebrow"
          >{getContent("sections.projects.eyebrow", projectsEyebrowDefault)}</Text
        >
      </div>
      <Text
        tag="h2"
        variant="displayMD"
        class="font-semibold leading-snug text-left tracking-tighter lg:col-span-2 text-base-900 dark:text-white"
        data-editable="sections.projects.title"
      >
        {getContent("sections.projects.title", "Projetos")}
      </Text>
    </div>

    <div class="flex flex-col mt-8">
      <CaseCard item={featuredProject} contentPrefix="projects" basePath="projeto" />
      <div class="grid grid-cols-1 lg:grid-cols-2 lg:gap-x-4">
        {
          otherProjects.map((item) => (
            <CaseCard item={item} contentPrefix="projects" basePath="projeto" compact />
          ))
        }
      </div>
    </div>
  </Wrapper>
</section>
