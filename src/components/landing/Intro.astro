---
// Fundations
import Button from "@/components/fundations/elements/Button.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { getContent } from "@/lib/getContent";

const introDefault =
  "Olá, sou Ana Luiza. Entre criatividade, comunicação e tecnologia, gosto de transformar ideias em experiências e soluções.";
const introSupportDefault =
  "Tenho interesse em explorar novas possibilidades, desenvolver projetos e conectar pessoas e marcas por meio da comunicação.";
---

<section>
  <Wrapper variant="standard" class="pb-8 pt-32 lg:pt-40">
    <div class="grid grid-cols-1 lg:grid-cols-4 items-start gap-y-8">
      <Text
        tag="h1"
        variant="displayXL"
        class="font-semibold leading-tight text-left tracking-tighter text-base-900 dark:text-white lg:col-span-3"
        data-editable="intro.text"
      >
        {getContent("intro.text", introDefault)}
      </Text>
      <div class="lg:col-span-2 lg:col-start-3">
        <Text
          tag="p"
          variant="textLG"
          class="max-w-xl text-base-600 dark:text-base-300"
          data-editable="intro.support"
        >
          {getContent("intro.support", introSupportDefault)}
        </Text>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button
            isLink
            href="#projects"
            variant="none"
            size="md"
            data-cursor-magnetic
            class="bg-base-900 px-6 text-white hover:bg-accent-700 dark:bg-white dark:text-base-900 dark:hover:bg-accent-400"
          >
            Ver projetos
          </Button>
          <Button
            isLink
            href="#contato"
            variant="none"
            size="md"
            data-cursor-magnetic
            class="border border-base-300 px-6 text-base-900 hover:border-base-900 dark:border-base-700 dark:text-white dark:hover:border-white"
          >
            Entrar em contato
          </Button>
        </div>
      </div>
    </div>
  </Wrapper>
</section>
