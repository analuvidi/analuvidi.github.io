---
// Fundations
import Button from "@/components/fundations/elements/Button.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { getContent } from "@/lib/getContent";

const introDefault = "Olá, sou Ana Luiza";
const introRoleDefault = "Desenvolvedora front-end · Designer UX/UI · Entusiasta de IA";
const introSupportDefault =
  "Tenho interesse em explorar novas possibilidades, desenvolver projetos e conectar pessoas por meio de soluções tecnológicas.";
---

<section>
  <Wrapper variant="standard" class="pb-8 pt-32 lg:pb-26 lg:pt-28">
    <div class="grid grid-cols-1 lg:grid-cols-4 lg:gap-x-4 items-center gap-y-10">
      <div class="lg:col-span-2 lg:col-start-3 lg:row-start-1">
        <Text
          tag="h1"
          variant="displayHero"
          class="font-semibold leading-tight text-left tracking-tighter text-base-900 dark:text-white"
          data-editable="intro.text"
        >
          {getContent("intro.text", introDefault)}
        </Text>
        <Text
          tag="p"
          variant="textBase"
          class="mt-3 font-medium tracking-tight text-base-900 dark:text-white"
          data-editable="intro.role"
        >
          {getContent("intro.role", introRoleDefault)}
        </Text>
        <Text
          tag="p"
          variant="textLG"
          class="mt-6 max-w-xl text-base-600 dark:text-base-300"
          data-editable="intro.support"
        >
          {getContent("intro.support", introSupportDefault)}
        </Text>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button
            isLink
            href="#projects"
            variant="none"
            size="md"
            data-cursor-magnetic
            class="bg-accent-700 px-6 text-white hover:bg-accent-800 dark:bg-accent-400 dark:text-base-950 dark:hover:bg-accent-300"
          >
            Ver projetos
          </Button>
          <Button
            isLink
            href="#contato"
            variant="none"
            size="md"
            data-cursor-magnetic
            class="border border-base-300 px-6 text-base-900 hover:border-base-900 dark:border-base-700 dark:text-white dark:hover:border-white"
          >
            Entrar em contato
          </Button>
        </div>
      </div>
    </div>
  </Wrapper>
</section>
