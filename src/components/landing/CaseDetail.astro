---
import defaultProjectImage from "@/images/projects/default.svg";
import CaseVideo from "@/components/landing/CaseVideo.astro";
import EditableImage from "@/components/landing/EditableImage.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import type { PortfolioCase } from "@/data/portfolio";
import { getContent, shouldRenderImage } from "@/lib/getContent";

interface Props {
  item: PortfolioCase;
  contentPrefix: string;
  backHref: string;
  backLabel: string;
}

const { item, contentPrefix, backHref, backLabel } = Astro.props;

const detail = item.detail!;
const [contextBlock, processBlock, resultBlock] = detail.blocks ?? [];
const key = (suffix: string) => `${contentPrefix}.${suffix}`;
const blockLabels = item.blockLabel
  ? ["01", "02", "03"].map((number) => `${item.blockLabel} ${number}`)
  : ["Contexto", "Processo", "Resultado"];

const images = item.blockImages ?? {};
const showHero = !detail.sections && shouldRenderImage(key("image"), item.image);
const showContext = shouldRenderImage(key("image.context"), images.context);
const processGallery = images.process && images.processSecondary
  ? { first: images.process, second: images.processSecondary }
  : undefined;
const showProcess = !processGallery && shouldRenderImage(key("image.process"), images.process);
const showResult = shouldRenderImage(key("image.result"), images.result);
---

<section class="pb-16 pt-32 lg:pb-32 lg:pt-40">
  <Wrapper variant="standard">
    <a
      href={backHref}
      class="tap-target text-sm tracking-tight text-base-600 transition-colors hover:text-accent-700 dark:text-base-300 dark:hover:text-accent-400"
    >
      ← {backLabel}
    </a>

    <div class="mt-8 grid grid-cols-1 gap-8 border-b border-base-200 pb-12 dark:border-base-800 lg:mt-12 lg:grid-cols-4 lg:items-start lg:gap-12">
      <Text
        tag="p"
        variant="textSM"
        class="uppercase text-base-600 dark:text-base-300"
        data-editable={key("year")}
      >
        {getContent(key("year"), item.year)}
      </Text>

      <div class="lg:col-span-2">
        <Text
          tag="h1"
          variant="displaySM"
          class="font-semibold leading-tight tracking-tighter text-base-900 dark:text-white"
          data-editable={key("title")}
        >
          {getContent(key("title"), item.title)}
        </Text>
        <Text
          tag="p"
          variant="textBase"
          class="mt-6 max-w-[58ch] text-base-600 dark:text-base-300"
          data-editable={key("summary")}
        >
          {getContent(key("summary"), detail.summary)}
        </Text>
      </div>

      <aside class="flex flex-col gap-6 border-t border-base-200 pt-6 dark:border-base-800 lg:border-t-0 lg:pt-0">
        <Text
          tag="p"
          variant="textSM"
          class="uppercase text-base-600 dark:text-base-300"
          data-editable={key("category")}
        >
          {getContent(key("category"), item.category)}
        </Text>
        {
          detail.meta.map((entry, index) => (
            <div>
              <Text
                tag="p"
                variant="textSM"
                class="uppercase text-base-500 dark:text-base-400"
                data-editable={key(`meta.${index}.label`)}
              >
                {getContent(key(`meta.${index}.label`), entry.label)}
              </Text>
              <Text
                tag="p"
                variant="textBase"
                class="mt-1 text-base-700 dark:text-base-200"
                data-editable={key(`meta.${index}.value`)}
              >
                {getContent(key(`meta.${index}.value`), entry.value)}
              </Text>
            </div>
          ))
        }
      </aside>
    </div>

    {
      showHero && (
        <EditableImage
          imageKey={key("image")}
          width={item.image?.width ?? 1420}
          height={item.image?.height ?? 930}
          src={item.image ?? defaultProjectImage}
          alt={item.imageAlt ?? `Imagem principal de ${item.title}`}
          class="mt-12 aspect-[16/10] w-full object-cover object-center lg:mt-16"
        />
      )
    }

    {
      contextBlock && (
        <section
          class:list={[
            "pt-12 lg:pt-16",
            showHero && "mt-16 border-t border-base-200 dark:border-base-800 lg:mt-24",
          ]}
        >
          <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-12 lg:items-start">
            <div class="lg:col-span-3">
              <Text tag="p" variant="textSM" class="uppercase text-base-600 dark:text-base-300">
                {blockLabels[0]}
              </Text>
              <Text
                tag="p"
                variant="textBase"
                class="mt-6 max-w-xs text-base-500 dark:text-base-400"
                data-editable={key("blocks.0.aside")}
              >
                {getContent(key("blocks.0.aside"), contextBlock.aside)}
              </Text>
            </div>

            <div class={showContext ? "lg:col-span-4" : "lg:col-span-6 lg:col-start-7"}>
              <Text
                tag="h2"
                variant="textLG"
                class="font-semibold leading-tight text-base-900 dark:text-white"
                data-editable={key("blocks.0.heading")}
              >
                {getContent(key("blocks.0.heading"), contextBlock.heading)}
              </Text>
              <Text
                tag="p"
                variant="textBase"
                class="mt-4 max-w-[58ch] text-base-600 dark:text-base-300"
                data-editable={key("blocks.0.text")}
              >
                {getContent(key("blocks.0.text"), contextBlock.text)}
              </Text>
            </div>

            {
              showContext && (
                <div class="lg:col-span-5">
                  <EditableImage
                    imageKey={key("image.context")}
                    width={images.context?.width ?? 900}
                    height={images.context?.height ?? 1100}
                    src={images.context ?? defaultProjectImage}
                    alt={`Tela de ${item.title}: ${contextBlock.heading}`}
                    class="aspect-[4/5] w-full object-cover object-center"
                  />
                </div>
              )
            }
          </div>
        </section>
      )
    }

    {
      processBlock && (
        <section class="mt-16 border-t border-base-200 pt-12 dark:border-base-800 lg:mt-24 lg:pt-16">
          <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-12 lg:items-center">
            {
              showProcess && (
                <div class="order-2 lg:order-1 lg:col-span-5">
                  <EditableImage
                    imageKey={key("image.process")}
                    width={images.process?.width ?? 900}
                    height={images.process?.height ?? 700}
                    src={images.process ?? defaultProjectImage}
                    alt={`Tela de ${item.title}: ${processBlock.heading}`}
                    class="aspect-[5/4] w-full object-cover object-center"
                  />
                </div>
              )
            }

            <div class={showProcess ? "order-1 lg:order-2 lg:col-span-4 lg:col-start-6" : "order-1 lg:col-span-6 lg:col-start-7"}>
              <Text tag="p" variant="textSM" class="uppercase text-base-600 dark:text-base-300">
                {blockLabels[1]}
              </Text>
              <Text
                tag="h2"
                variant="textLG"
                class="mt-2 font-semibold leading-tight text-base-900 dark:text-white"
                data-editable={key("blocks.1.heading")}
              >
                {getContent(key("blocks.1.heading"), processBlock.heading)}
              </Text>
              <Text
                tag="p"
                variant="textBase"
                class="mt-4 max-w-[58ch] text-base-600 dark:text-base-300"
                data-editable={key("blocks.1.text")}
              >
                {getContent(key("blocks.1.text"), processBlock.text)}
              </Text>
            </div>

            <div class={showProcess ? "order-3 lg:col-span-3 lg:col-start-10 lg:row-start-1" : "order-3 lg:col-span-3 lg:col-start-1 lg:row-start-1"}>
              <Text
                tag="p"
                variant="textBase"
                class:list={["max-w-xs text-base-500 dark:text-base-400", showProcess && "lg:ml-auto lg:text-right"]}
                data-editable={key("blocks.1.aside")}
              >
                {getContent(key("blocks.1.aside"), processBlock.aside)}
              </Text>
            </div>
          </div>

          {
            processGallery && (
              <div class="mt-10 grid grid-cols-1 gap-6 lg:mt-12 lg:grid-cols-2">
                <EditableImage
                  imageKey={key("image.process")}
                  width={processGallery.first.width}
                  height={processGallery.first.height}
                  src={processGallery.first}
                  alt={images.processAlt ?? `Imagem de ${item.title}: ${processBlock.heading}`}
                  class="aspect-video w-full object-cover object-center"
                />
                <EditableImage
                  imageKey={key("image.process.secondary")}
                  width={processGallery.second.width}
                  height={processGallery.second.height}
                  src={processGallery.second}
                  alt={images.processSecondaryAlt ?? `Imagem de ${item.title}: ${processBlock.heading}`}
                  class={`aspect-video w-full object-cover ${images.processSecondaryPosition ?? "object-center"}`}
                />
              </div>
            )
          }
        </section>
      )
    }

    {
      resultBlock && (
        <section class="mt-16 border-t border-base-200 pt-12 dark:border-base-800 lg:mt-24 lg:pt-16">
          <div class="grid grid-cols-1 gap-8 lg:grid-cols-4">
            <Text tag="p" variant="textSM" class="uppercase text-base-600 dark:text-base-300">
              {blockLabels[2]}
            </Text>

            <div class="lg:col-span-2">
              <Text
                tag="h2"
                variant="textLG"
                class="font-semibold leading-tight text-base-900 dark:text-white"
                data-editable={key("blocks.2.heading")}
              >
                {getContent(key("blocks.2.heading"), resultBlock.heading)}
              </Text>
              <Text
                tag="p"
                variant="textBase"
                class="mt-4 max-w-[58ch] text-base-600 dark:text-base-300"
                data-editable={key("blocks.2.text")}
              >
                {getContent(key("blocks.2.text"), resultBlock.text)}
              </Text>
            </div>

            <Text
              tag="p"
              variant="textBase"
              class="text-base-500 lg:ml-auto lg:max-w-xs lg:text-right dark:text-base-400"
              data-editable={key("blocks.2.aside")}
            >
              {getContent(key("blocks.2.aside"), resultBlock.aside)}
            </Text>
          </div>

          {
            showResult && (
              <EditableImage
                imageKey={key("image.result")}
                width={images.result?.width ?? 1420}
                height={images.result?.height ?? 930}
                src={images.result ?? defaultProjectImage}
                alt={`Tela de ${item.title}: ${resultBlock.heading}`}
                class="mt-10 aspect-[16/9] w-full object-cover object-center lg:mt-12"
              />
            )
          }
        </section>
      )
    }

    {
      detail.sections?.map((section, index) => (
        <section
          class:list={[
            "pt-12 lg:pt-16",
            index > 0 && "mt-16 border-t border-base-200 dark:border-base-800 lg:mt-24",
          ]}
        >
          <div class="grid grid-cols-1 gap-6 lg:grid-cols-12 lg:items-start lg:gap-12">
            <div class="lg:col-span-3">
              <Text
                tag="p"
                variant="textSM"
                class="uppercase text-base-600 dark:text-base-300"
                data-editable={key(`sections.${index}.label`)}
              >
                {getContent(key(`sections.${index}.label`), section.label)}
              </Text>
              {
                section.aside && (
                  <Text
                    tag="p"
                    variant="textBase"
                    class="mt-6 max-w-xs text-base-500 dark:text-base-400"
                    data-editable={key(`sections.${index}.aside`)}
                  >
                    {getContent(key(`sections.${index}.aside`), section.aside)}
                  </Text>
                )
              }
            </div>
            <div class="lg:col-span-6 lg:col-start-7">
              <Text
                tag="h2"
                variant="textLG"
                class="font-semibold leading-tight text-base-900 dark:text-white"
                data-editable={key(`sections.${index}.heading`)}
              >
                {getContent(key(`sections.${index}.heading`), section.heading)}
              </Text>
              <Text
                tag="p"
                variant="textBase"
                class="mt-4 max-w-[58ch] text-base-600 dark:text-base-300"
                data-editable={key(`sections.${index}.text`)}
              >
                {getContent(key(`sections.${index}.text`), section.text)}
              </Text>
            </div>
          </div>
          {
            section.media.length > 0 && (
              <div class:list={["mt-10 grid grid-cols-1 gap-6 lg:mt-12", section.media.length > 1 && "lg:grid-cols-2"]}>
                {
                  section.media.map((media, mediaIndex) =>
                    media.type === "video" ? (
                      <CaseVideo src={media.src} poster={media.poster} alt={media.alt} width={1920} height={1080} />
                    ) : (
                      <EditableImage
                        imageKey={key(`sections.${index}.media.${mediaIndex}`)}
                        width={media.src.width}
                        height={media.src.height}
                        src={media.src}
                        alt={media.alt}
                        class="h-auto w-full"
                      />
                    ),
                  )
                }
              </div>
            )
          }
        </section>
      ))
    }

    <div class="mt-16 border-t border-base-200 pt-10 dark:border-base-800 lg:mt-24">
      <a
        href={backHref}
        class="tap-target text-sm tracking-tight text-base-600 transition-colors hover:text-accent-700 dark:text-base-300 dark:hover:text-accent-400"
      >
        ← {backLabel}
      </a>
    </div>
  </Wrapper>
</section>
