---
import defaultProjectImage from "@/images/projects/default.svg";
import EditableImage from "@/components/landing/EditableImage.astro";
import PortfolioMediaLink from "@/components/landing/PortfolioMediaLink.astro";
import TagList from "@/components/landing/TagList.astro";
import Text from "@/components/fundations/elements/Text.astro";
import type { PortfolioCase } from "@/data/portfolio";
import { getContent, shouldRenderImage } from "@/lib/getContent";

interface Props {
  item: PortfolioCase;
  /** Prefixo das chaves editáveis: "work" ou "projects". */
  contentPrefix: string;
  /** Rota base da página do case: "trabalho" ou "projeto". */
  basePath: string;
}

const { item, contentPrefix, basePath } = Astro.props;

const key = (suffix: string) => `${contentPrefix}.${item.slug}.${suffix}`;
const detailHref = item.detail ? `/${basePath}/${item.slug}` : undefined;
const showImage = Boolean(detailHref) && shouldRenderImage(key("image"), item.image);
const linkClass =
  "tap-target mt-6 inline-block text-sm tracking-tight text-base-900 underline underline-offset-4 transition-colors hover:text-accent-700 dark:text-white dark:hover:text-accent-400";
---

<article class="py-12 border-t border-base-200 dark:border-base-800">
  <div class="grid grid-cols-1 gap-4 lg:grid-cols-4 items-start">
    <Text
      tag="p"
      variant="textSM"
      class="text-base-600 dark:text-base-300 uppercase"
      data-editable={key("year")}
    >
      {getContent(key("year"), item.year)}
    </Text>
    <div>
      <Text
        tag="h3"
        variant="textLG"
        class="text-base-900 dark:text-white leading-tight font-semibold"
        data-editable={key("title")}
      >
        {getContent(key("title"), item.title)}
      </Text>
      {
        item.organization && (
          <Text
            tag="p"
            variant="textBase"
            class="mt-2 text-base-600 dark:text-base-300"
            data-editable={key("organization")}
          >
            {getContent(key("organization"), item.organization)}
          </Text>
        )
      }
    </div>
    <div>
      <Text
        tag="p"
        variant="textBase"
        class="text-base-600 dark:text-base-300"
        data-editable={key("description")}
      >
        {getContent(key("description"), item.description)}
      </Text>
      {
        detailHref && (
          <a href={detailHref} data-cursor-magnetic class={linkClass}>
            {basePath === "projeto" ? "Ver projeto" : "Ver mais"}
          </a>
        )
      }
      {
        item.link && (
          <a
            href={item.link.href}
            target="_blank"
            rel="noopener noreferrer"
            data-cursor-magnetic
            class={linkClass}
          >
            {item.link.label}
          </a>
        )
      }
    </div>
    <div>
      <Text
        tag="p"
        variant="textSM"
        class="text-base-900 dark:text-white uppercase lg:text-right"
        data-editable={key("category")}
      >
        {getContent(key("category"), item.category)}
      </Text>
      {item.skills && <TagList tags={item.skills} class="mt-3" />}
    </div>
  </div>
  {
    showImage && detailHref && (
      <PortfolioMediaLink href={detailHref}>
        <EditableImage
          imageKey={key("image")}
          width={item.image?.width ?? 1420}
          height={item.image?.height ?? 930}
          src={item.image ?? defaultProjectImage}
          alt={item.imageAlt ?? `Imagem de ${item.title}`}
          loading="lazy"
          decoding="async"
          class="size-full aspect-video object-cover object-center transition-transform duration-500 group-hover:scale-[1.02]"
        />
      </PortfolioMediaLink>
    )
  }
</article>
