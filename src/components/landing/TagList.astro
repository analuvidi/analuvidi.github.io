---
interface Props {
  tags: string[];
  class?: string;
}

const { tags, class: className = "" } = Astro.props;
---

<ul
  class:list={[
    "flex flex-wrap gap-x-3 gap-y-1 text-sm text-base-500 dark:text-base-400 lg:justify-end lg:pl-8 lg:text-right",
    className,
  ]}
>
  {tags.map((tag) => <li>{tag}</li>)}
</ul>
