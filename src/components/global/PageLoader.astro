<div
  id="page-loader"
  class="fixed inset-0 z-50 flex flex-col bg-white dark:bg-base-950"
  aria-hidden="true"
>
  <div class="flex items-start justify-between px-6 py-6 lg:px-12">
    <span class="text-sm tracking-tight text-base-600 dark:text-base-300">Ana Luiza Vidigal</span>
    <span class="text-sm tracking-tight text-base-600 dark:text-base-300 uppercase"
      >Carregando</span
    >
  </div>

  <div class="flex flex-1 items-center justify-center">
    <div class="flex items-end gap-1">
      <span
        id="loader-counter"
        class="text-[clamp(4rem,18vw,12rem)] font-semibold leading-none tracking-tighter text-base-900 dark:text-white tabular-nums"
        >0</span
      >
      <span
        class="mb-[0.35em] text-[clamp(1.25rem,4vw,2.5rem)] font-semibold tracking-tighter text-base-400 dark:text-base-500"
        >%</span
      >
    </div>
  </div>

  <div class="px-6 pb-8 lg:px-12">
    <div class="h-px w-full overflow-hidden bg-base-200 dark:bg-base-800">
      <div
        id="loader-progress"
        class="h-full w-0 origin-left bg-base-900 dark:bg-white"
      ></div>
    </div>
  </div>
</div>

<script>
  import gsap from "gsap";

  const root = document.documentElement;
  const loader = document.getElementById("page-loader");
  const counter = document.getElementById("loader-counter");
  const progress = document.getElementById("loader-progress");
  const pageContent = document.getElementById("page-content");

  // Quem liga a classe é o script do <head>: só na primeira página da visita
  // e sem "reduzir movimento". Sem ela, o conteúdo já está visível.
  if (!root.classList.contains("has-loader")) {
    loader?.remove();
  } else if (loader && counter && progress) {
    const counterState = { value: 0 };

    gsap.to(counterState, {
      value: 100,
      duration: 0.8,
      ease: "power2.inOut",
      onUpdate: () => {
        const current = Math.round(counterState.value);
        counter.textContent = String(current);
        progress.style.width = `${current}%`;
      },
      onComplete: () => {
        const timeline = gsap.timeline({
          onStart: () => {
            window.dispatchEvent(new CustomEvent("page-loader-complete"));
          },
          onComplete: () => {
            loader.remove();
            root.classList.remove("has-loader");
            if (pageContent) gsap.set(pageContent, { clearProps: "opacity" });
          },
        });

        timeline.to(loader, {
          yPercent: -100,
          duration: 0.5,
          ease: "power4.inOut",
        });

        if (pageContent) {
          timeline.to(
            pageContent,
            {
              opacity: 1,
              duration: 0.4,
              ease: "power2.out",
            },
            "-=0.25",
          );
        }
      },
    });
  }
</script>
