---
// Assets
import Logo from "@/components/assets/Logo.astro";
// Fundations
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import EditableLink from "@/components/global/EditableLink.astro";
import { getContent } from "@/lib/getContent";

const links = [
  { href: "/#sobre", text: "Sobre" },
  { href: "/#projects", text: "Projetos" },
  { href: "/#work", text: "Experiência" },
  { href: "/#skills", text: "Competências" },
  { href: "/#education", text: "Formação" },
];

// O estado da seção atual vem do script abaixo, via aria-current.
const currentClass =
  "aria-[current=true]:text-accent-700 aria-[current=true]:underline aria-[current=true]:underline-offset-4 dark:aria-[current=true]:text-accent-400";
---

<nav class="bg-white dark:bg-[#111111] fixed top-0 z-10 w-full transition-transform duration-200 motion-reduce:transition-none">
  <Wrapper variant="standard" class="py-5 pointer-coarse:py-1">
    <div class="grid grid-cols-3 lg:grid-cols-4 lg:gap-x-4 items-center">
      <a href="/" class="tap-target group flex whitespace-nowrap">
        <Logo
          class="text-base-900 dark:text-white text-lg font-medium tracking-tight transition-colors group-hover:text-accent-700 dark:group-hover:text-accent-400"
        />
      </a>
      <div class="hidden lg:col-start-3 lg:flex gap-x-3 xl:gap-x-6 whitespace-nowrap text-base items-center">
        {
          links.map((link) => (
            <a
              href={link.href}
              data-cursor-magnetic
              class:list={[
                "tap-target text-base-600 dark:text-base-300 tracking-tight text-[0.9375rem] xl:text-base transition-colors hover:text-accent-700 dark:hover:text-accent-400",
                currentClass,
              ]}
            >
              {link.text}
            </a>
          ))
        }
      </div>
      <div class="hidden justify-end lg:col-start-4 lg:flex">
        <EditableLink
          linkKey="nav.contact"
          href="/#contato"
          data-cursor-magnetic
          class={`tap-target text-base-600 dark:text-base-300 text-[0.9375rem] xl:text-base tracking-tight font-base transition-colors hover:text-accent-700 dark:hover:text-accent-400 ${currentClass}`}
        >
          {getContent("nav.contact", "Contato")}
        </EditableLink>
      </div>
    </div>
    <div
      data-nav-scroller
      class="mt-2 flex justify-between gap-4 overflow-x-auto scrollbar-hide pointer-coarse:mt-0 sm:justify-start sm:gap-5 lg:hidden"
    >
      {
        [...links, { href: "/#contato", text: "Contato" }].map((link) => (
          <a
            href={link.href}
            class:list={[
              "tap-target shrink-0 text-base-600 dark:text-base-300 tracking-tight text-[0.9375rem] transition-colors hover:text-accent-700 dark:hover:text-accent-400",
              currentClass,
            ]}
          >
            {link.text}
          </a>
        ))
      }
    </div>
  </Wrapper>
</nav>

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('nav a[href^="/#"]'));
  const scroller = document.querySelector<HTMLElement>("[data-nav-scroller]");
  let currentId: string | null = null;

  function setCurrent(id: string | null) {
    currentId = id;

    links.forEach((link) => {
      if (link.hash !== `#${id}`) {
        link.removeAttribute("aria-current");
        return;
      }

      link.setAttribute("aria-current", "true");

      // No celular a lista rola de lado: mantém o item atual à vista.
      if (scroller?.contains(link) && scroller.scrollWidth > scroller.clientWidth) {
        scroller.scrollTo({
          left: link.offsetLeft - scroller.offsetLeft - (scroller.clientWidth - link.offsetWidth) / 2,
        });
      }
    });
  }

  if (location.pathname.startsWith("/trabalho")) {
    setCurrent("work");
  } else if (location.pathname.startsWith("/projeto")) {
    setCurrent("projects");
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) setCurrent(entry.target.id);
          else if (entry.target.id === currentId) setCurrent(null);
        });
      },
      { rootMargin: "-45% 0px -50% 0px" },
    );

    links.forEach((link) => {
      const section = document.getElementById(link.hash.slice(1));
      if (section) observer.observe(section);
    });
  }

  // No celular, ao rolar, só a lista de seções fica à vista. Quem navega por
  // teclado continua vendo o cabeçalho inteiro.
  const nav = document.querySelector<HTMLElement>("nav");

  function updateCompact() {
    if (!nav || !scroller) return;

    const compact = window.scrollY > 80 && !nav.querySelector(":focus-visible");
    nav.style.transform = compact ? `translateY(-${scroller.offsetTop}px)` : "";
  }

  window.addEventListener("scroll", updateCompact, { passive: true });
  window.addEventListener("resize", updateCompact);
  nav?.addEventListener("focusin", updateCompact);
  updateCompact();
</script>
