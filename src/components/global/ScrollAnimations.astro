<script>
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { initPageAnimations, refreshScrollAnimations } from "@/lib/scrollAnimations";

  function setup(revealVisible = false) {
    initPageAnimations({ revealVisible });
    window.setTimeout(() => {
      ScrollTrigger.refresh();
      // Só depois do refresh: antes, ele cancela a rolagem até a âncora ao abrir a página.
      document.documentElement.classList.add("motion-safe:scroll-smooth");
    }, 150);
  }

  window.addEventListener("content-overrides-applied", () => {
    refreshScrollAnimations();
    window.setTimeout(() => ScrollTrigger.refresh(), 150);
  });

  if (document.documentElement.classList.contains("has-loader")) {
    window.addEventListener("page-loader-complete", () => setup(true), { once: true });
  } else if (document.readyState === "complete") {
    setup();
  } else {
    window.addEventListener("load", () => setup(), { once: true });
  }
</script>
