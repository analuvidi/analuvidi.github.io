---
// Fundation
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<BaseLayout title="Página não encontrada">
  <section>
    <Wrapper variant="standard" class="pb-8 pt-40 lg:pt-80">
      <div class="grid grid-cols-1 lg:grid-cols-4 lg:gap-x-4 items-end gap-y-8">
        <div class="lg:col-span-2 lg:col-start-3">
          <Text
            tag="h1"
            variant="displayLG"
            class="font-semibold leading-snug text-left tracking-tighter text-base-900 dark:text-white"
          >
            404 — Página não encontrada
          </Text>
          <div class="mt-8 flex">
            <Button
              isLink
              href="/"
              variant="none"
              size="md"
              data-cursor-magnetic
              class="bg-accent-700 px-6 text-white hover:bg-accent-800 dark:bg-accent-400 dark:text-base-950 dark:hover:bg-accent-300"
            >
              Voltar para o início
            </Button>
          </div>
        </div>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
