---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CaseDetail from "@/components/landing/CaseDetail.astro";
import { getWorkItem, workItems } from "@/data/portfolio";

export function getStaticPaths() {
  return workItems.filter((item) => item.detail).map((item) => ({
    params: { slug: item.slug },
  }));
}

const { slug } = Astro.params;
const item = getWorkItem(slug!);

if (!item) {
  return Astro.redirect("/404");
}
---

<BaseLayout title={item.title} description={item.detail?.summary ?? item.description}>
  <CaseDetail
    item={item}
    contentPrefix={`work.${item.slug}`}
    backHref="/#work"
    backLabel="Voltar para Experiência"
  />
</BaseLayout>
